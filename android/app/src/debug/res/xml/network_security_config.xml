<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: trusts the CA of the fake Subsonic server the
     integration tests run on localhost (test/test_helpers/
     fake_subsonic_server.dart, generated by tool/fake_server_cert.sh), so
     ExoPlayer and the artwork loader can reach it. Only for localhost, and
     in addition to the system CAs. Release builds have no network security
     config. -->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="false">localhost</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/fake_subsonic_server" />
        </trust-anchors>
    </domain-config>
</network-security-config>
