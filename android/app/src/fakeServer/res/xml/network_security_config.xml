<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds, and the release build of tool/emulator_check.sh in fake
     server mode (-PtrustFakeServer=true, see android/app/build.gradle.kts):
     trusts the CA of the fake Subsonic server the tests run on localhost
     (test/test_helpers/fake_subsonic_server.dart, generated by
     tool/fake_server_cert.sh), so ExoPlayer and the artwork loader can reach
     it. Only for localhost, and in addition to the system CAs. The release
     APK has no network security config. -->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="false">localhost</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/fake_subsonic_server" />
        </trust-anchors>
    </domain-config>
</network-security-config>
